{
  "name": "claude-ui-toolchain",
  "description": "Toolchain UI, front-end e design di Claude Code, distribuita come plugin.",
  "owner": { "name": "GitAlboBis" },
  "marketplaceSource": "GitAlboBis/claude-ui-toolchain",
  "plugin": {
    "name": "ui-design",
    "description": "Hook di routing per i prompt di UI, front-end e design, con 97 skill e i connettori MCP di componenti e riferimenti.",
    "userConfig": {
      "originkit_api_key": {
        "type": "string",
        "title": "Chiave API di OriginKit",
        "description": "Da originkit.dev > Settings > API Integration. Senza chiave il connettore originkit non si connette.",
        "sensitive": true
      },
      "context7_api_key": {
        "type": "string",
        "title": "Chiave API di Context7",
        "description": "Facoltativa: senza chiave Context7 funziona con limiti di richieste più bassi.",
        "sensitive": true,
        "default": ""
      }
    },
    "install": {
      "env": { "originkit_api_key": "ORIGINKIT_API_KEY", "context7_api_key": "CONTEXT7_API_KEY" },
      "required": ["originkit_api_key"],
      "withoutKey": { "originkit_api_key": "il connettore originkit risponde 401" }
    }
  },
  "hooks": ["ui-design-router.js", "ui-design-routing.md"],
  "rules": ["frontend-visual-skills.md", "context7.md"],
  "skills": [
    "21st-ai", "21st-cli-use", "21st-design-sync", "21st-registry", "21st-ui-build", "21st-ui-explore", "21st-ui-review",
    "3d-web-experience", "animate", "animate-expo", "animation-vocabulary", "apple-design", "ask-sonner", "avoid-ai-writing",
    "awwwards-animations", "baseline-ui", "brainstorming", "design-md", "design-taste-frontend", "dispatching-parallel-agents",
    "emil-design-eng", "executing-plans", "find-animation-opportunities", "finishing-a-development-branch",
    "fixing-accessibility", "fixing-motion-performance", "frontend-design", "full-output-enforcement", "gpt-taste",
    "gsap-core", "gsap-frameworks", "gsap-performance", "gsap-plugins", "gsap-react", "gsap-scrolltrigger", "gsap-timeline",
    "gsap-utils", "high-end-visual-design", "impeccable", "improve-animations", "industrial-brutalist-ui", "lighthouse",
    "minimalist-ui", "motion-design", "motion-framer", "pick-ui-library", "prototype", "receiving-code-review",
    "redesign-existing-projects", "requesting-code-review", "review-animations", "scroll-experience", "shadcn",
    "shader-programming-glsl", "spline-3d-integration", "stitch-design-taste", "stop-slop", "subagent-driven-development",
    "svg-animations", "systematic-debugging", "tailwind-design-system", "tailwind-patterns", "test-driven-development",
    "theme-factory", "threejs-animation", "threejs-fundamentals", "threejs-geometry", "threejs-interaction",
    "threejs-lighting", "threejs-loaders", "threejs-materials", "threejs-postprocessing", "threejs-shaders", "threejs-skills",
    "threejs-textures", "transitions-dev", "transitions-polish", "ui-a11y", "ui-component", "ui-page", "ui-pattern",
    "ui-review", "ui-setup", "ui-tokens", "ui-ux-pro-max", "using-git-worktrees", "using-superpowers", "ux-audit", "ux-copy",
    "ux-feedback", "ux-flow", "uxui-principles", "vengeance-ui", "verification-before-completion", "web-design-guidelines",
    "writing-plans", "writing-skills"
  ],
  "mcpServers": {
    "originkit": {
      "type": "http",
      "url": "https://mcp.originkit.dev/mcp",
      "headers": { "Authorization": "Bearer ${user_config.originkit_api_key}" }
    },
    "mobbin": { "type": "http", "url": "https://api.mobbin.com/mcp" },
    "ui-layouts-mcp": { "command": "cmd", "args": ["/c", "npx", "-y", "@ui-layouts/mcp"] },
    "shadcn": { "command": "cmd", "args": ["/c", "npx", "-y", "shadcn@latest", "mcp"] },
    "magicuidesign": { "command": "cmd", "args": ["/c", "npx", "-y", "@magicuidesign/mcp@latest"] },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": { "CONTEXT7_API_KEY": "${user_config.context7_api_key}" }
    }
  },
  "plugins": [
    { "id": "ecc@ecc", "marketplace": { "name": "ecc", "source": "https://github.com/affaan-m/ECC.git" } }
  ],
  "secretAllowlist": []
}
