{
  "mcpServers": {
    "originkit": {
      "type": "http",
      "url": "https://mcp.originkit.dev/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.originkit_api_key}"
      }
    },
    "mobbin": {
      "type": "http",
      "url": "https://api.mobbin.com/mcp"
    },
    "ui-layouts-mcp": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@ui-layouts/mcp"
      ]
    },
    "shadcn": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "shadcn@latest",
        "mcp"
      ]
    },
    "magicuidesign": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@magicuidesign/mcp@latest"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${user_config.context7_api_key}"
      }
    }
  }
}
